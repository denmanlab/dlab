let state = {
  rows: [],
  recordings: [],
  queue: [],
  worker: null,
  profiles: [],
  selectedProfileName: localStorage.getItem("selectedProfileName") || "default",
  profilePayload: null,
  profileDirty: false,
  selectedSessionId: "",
  selectedRecordingKey: localStorage.getItem("selectedRecordingKey") || "",
  selectedProbe: null,
  jobs: [],
  activeJob: null,
  stimulus: null,
  units: null,
  nwbMetadata: null,
  logStream: "out",
  mouseFilter: localStorage.getItem("mouseFilter") || "all",
  dateFilter: localStorage.getItem("dateFilter") || "all",
  machineRole: "analysis",
};

const $ = (id) => document.getElementById(id);

async function api(path, options = {}) {
  const response = await fetch(path, {
    headers: { "Content-Type": "application/json" },
    ...options,
  });
  if (!response.ok) {
    let detail = response.statusText;
    try {
      detail = (await response.json()).detail || detail;
    } catch (_) {}
    throw new Error(detail);
  }
  return response.json();
}

function escapeHtml(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function fileLink(path, label) {
  if (!path) return "";
  return `<a href="/files?path=${encodeURIComponent(path)}" target="_blank" rel="noreferrer">${label}</a>`;
}

function setBadge(id, text, klass) {
  const element = $(id);
  if (!element) return;
  element.textContent = text;
  element.className = `badge ${klass || stageClass(text)}`;
}

function badge(value) {
  const text = value || "n/a";
  const klass = String(text).replace(/[^A-Za-z0-9_-]+/g, "_");
  return `<span class="badge ${klass}">${escapeHtml(text)}</span>`;
}

function stageClass(status) {
  return String(status || "pending").replace(/[^A-Za-z0-9_-]+/g, "_");
}

function rowMouseId(row) {
  return row.mouse_id || row.animal_id || "";
}

function recordingKey(row) {
  return row.recording_id || row.raw_folder || `${rowMouseId(row)}|${row.recording_date || ""}|${row.task || ""}`;
}

function recordingName(row) {
  const raw = row.raw_folder || "";
  const parts = raw.split(/[\\/]+/).filter(Boolean);
  const session = parts[parts.length - 1] || `${rowMouseId(row)} ${row.recording_date || ""}`;
  return row.recording_block ? `${session} / ${row.recording_block}` : session;
}

function recordingGroups(rows) {
  const groups = new Map();
  rows.forEach((row) => {
    const key = recordingKey(row);
    if (!groups.has(key)) {
      groups.set(key, { key, name: recordingName(row), rows: [], mouse: rowMouseId(row), date: row.recording_date || "", task: row.task || "" });
    }
    groups.get(key).rows.push(row);
  });
  return [...groups.values()].sort((a, b) => `${a.mouse} ${a.date} ${a.name}`.localeCompare(`${b.mouse} ${b.date} ${b.name}`));
}

function representativeRow(group) {
  if (!group || !group.rows.length) return {};
  return group.rows.find((row) => row.probe_label === "ProbeA") || group.rows[0];
}

function derivedBackupSummary(group) {
  const rows = group?.rows || [];
  const statuses = rows.map((row) => row.derived_backup_status || "").filter(Boolean);
  if (!statuses.length) return { status: "missing", detail: "" };
  if (statuses.some((status) => status === "failed")) {
    const failed = rows.find((row) => row.derived_backup_status === "failed") || {};
    return { status: "failed", detail: failed.derived_backup_error || "" };
  }
  if (statuses.every((status) => status === "verified")) {
    const row = rows.find((item) => item.derived_backup_folder) || rows[0] || {};
    return { status: "verified", detail: row.derived_backup_folder || "" };
  }
  return { status: "partial", detail: statuses.join(", ") };
}

function nwbBackupSummary(group) {
  const rows = group?.rows || [];
  const statuses = rows.map((row) => row.nwb_backup_status || "").filter(Boolean);
  if (!statuses.length) return { status: "missing", detail: "" };
  if (statuses.some((status) => status === "failed")) {
    const failed = rows.find((row) => row.nwb_backup_status === "failed") || {};
    return { status: "failed", detail: failed.nwb_backup_error || "" };
  }
  if (statuses.every((status) => status === "verified")) {
    const row = rows.find((item) => item.nwb_backup_path || item.nwb_backup_folder) || rows[0] || {};
    return { status: "verified", detail: row.nwb_backup_path || row.nwb_backup_folder || "" };
  }
  return { status: "partial", detail: statuses.join(", ") };
}

function selectedRecordingGroup() {
  const groups = recordingGroups(filteredRows());
  return groups.find((group) => group.key === state.selectedRecordingKey) || groups[0] || null;
}

function selectedNwbSessionId() {
  return representativeRow(selectedRecordingGroup()).session_id || selectedSessionId();
}

function filteredRows() {
  return state.rows.filter((row) => {
    const mouseMatches = state.mouseFilter === "all" || rowMouseId(row) === state.mouseFilter;
    const dateMatches = state.dateFilter === "all" || (row.recording_date || "") === state.dateFilter;
    return mouseMatches && dateMatches;
  });
}

function uniqueValues(rows, getter) {
  return [...new Set(rows.map(getter).filter(Boolean))].sort();
}

function renderFilterOptions() {
  const mouseValues = uniqueValues(state.rows, rowMouseId);
  if (state.mouseFilter !== "all" && !mouseValues.includes(state.mouseFilter)) {
    state.mouseFilter = "all";
  }
  $("mouse-filter").innerHTML = [
    '<option value="all">All mice</option>',
    ...mouseValues.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`),
  ].join("");
  $("mouse-filter").value = state.mouseFilter;

  const rowsForDates = state.rows.filter((row) => state.mouseFilter === "all" || rowMouseId(row) === state.mouseFilter);
  const dateValues = uniqueValues(rowsForDates, (row) => row.recording_date || "");
  if (state.dateFilter !== "all" && !dateValues.includes(state.dateFilter)) {
    state.dateFilter = "all";
  }
  $("date-filter").innerHTML = [
    '<option value="all">All dates</option>',
    ...dateValues.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`),
  ].join("");
  $("date-filter").value = state.dateFilter;
}

function renderStatus(payload) {
  state.rows = payload.rows || [];
  renderFilterOptions();
  const rows = filteredRows();
  const undiscovered = payload.undiscovered_recordings || [];
  $("undiscovered-banner").innerHTML = undiscovered.length
    ? `
      <strong>${undiscovered.length} unregistered recording${undiscovered.length === 1 ? "" : "s"} found on disk.</strong>
      <div class="muted">${undiscovered.map((item) => escapeHtml(item.name)).join(", ")}</div>
      <div>Click <strong>Scan Recordings</strong> to add eligible ProbeA/ProbeB rows to the registry.</div>
    `
    : "";
  if (!state.selectedSessionId && state.rows.length) {
    state.selectedSessionId = localStorage.getItem("selectedSessionId") || rows[0]?.session_id || state.rows[0].session_id;
  }
  $("running-badge").textContent = payload.has_running_rows ? "running" : "idle";
  $("running-badge").className = `badge ${payload.has_running_rows ? "running" : "complete"}`;

  const select = $("session-select");
  select.innerHTML = rows
    .map(
      (row) =>
        `<option value="${escapeHtml(row.session_id)}">${escapeHtml(rowMouseId(row))} ${escapeHtml(row.recording_date || "")} ${escapeHtml(row.probe_label || "")}</option>`
    )
    .join("");
  if (state.selectedSessionId) select.value = state.selectedSessionId;
  if (select.value !== state.selectedSessionId && rows.length) {
    state.selectedSessionId = rows[0].session_id;
    select.value = state.selectedSessionId;
    localStorage.setItem("selectedSessionId", state.selectedSessionId);
  }
  const groups = recordingGroups(rows);
  const selectedGroupIsVisible = groups.some((group) => group.key === state.selectedRecordingKey);
  if (!state.selectedRecordingKey || !selectedGroupIsVisible) {
    const selectedRowGroup = rows.find((row) => row.session_id === state.selectedSessionId);
    state.selectedRecordingKey = selectedRowGroup ? recordingKey(selectedRowGroup) : groups[0]?.key || "";
    localStorage.setItem("selectedRecordingKey", state.selectedRecordingKey);
  }
  const nwbSelect = $("nwb-recording-select");
  if (nwbSelect) {
    nwbSelect.innerHTML = groups
      .map((group) => {
        const probes = group.rows.map((row) => row.probe_label || "probe").join("+");
        return `<option value="${escapeHtml(group.key)}">${escapeHtml(group.mouse)} ${escapeHtml(group.date)} ${escapeHtml(group.name)} (${escapeHtml(probes)})</option>`;
      })
      .join("");
    nwbSelect.value = state.selectedRecordingKey;
  }

  const statusBody = $("status-body");
  if (statusBody) statusBody.innerHTML = groups
    .map((group) => {
      const probeBadges = group.rows
        .map((row) => `${escapeHtml(row.probe_label || "probe")} ${badge(row.status)}`)
        .join(" ");
      const derived = derivedBackupSummary(group);
      const header = `
        <tr class="recording-row" data-recording-key="${escapeHtml(group.key)}">
          <td colspan="7">
            <strong>${escapeHtml(group.mouse)} ${escapeHtml(group.date)}</strong>
            <span class="muted">${escapeHtml(group.name)}</span>
            <span class="recording-probes">${probeBadges}</span>
            <span class="recording-probes">generated backup ${badge(derived.status)}</span>
          </td>
        </tr>
      `;
      const probeRows = group.rows
        .map((row) => {
      const links = [
        fileLink(row.report, "HTML"),
        fileLink(row.summary_png, "PNG"),
        fileLink(row.summary_json, "JSON"),
        fileLink(row.unitrefine_labels, "Labels"),
      ]
        .filter(Boolean)
        .join(" ");
      const workflow = [
        row.local_stage_status && `stage ${badge(row.local_stage_status)}`,
        row.preprocess_status && `pre ${badge(row.preprocess_status)}`,
        row.sort_status && `ks ${badge(row.sort_status)}`,
        row.qc_status && `qc ${badge(row.qc_status)}`,
        row.phy_export_status && `phy ${badge(row.phy_export_status)}`,
        row.nwb_status && `nwb ${badge(row.nwb_status)}`,
        row.nwb_backup_status && `nwb backup ${badge(row.nwb_backup_status)}`,
        row.derived_backup_status && `synology out ${badge(row.derived_backup_status)}`,
        row.derived_local_backup_status && `local out ${badge(row.derived_local_backup_status)}`,
        row.local_recording_archive_status && `full D: ${badge(row.local_recording_archive_status)}`,
      ]
        .filter(Boolean)
        .join(" ");
      const selected = row.session_id === state.selectedSessionId ? "selected-row" : "";
      return `
        <tr class="${selected}" data-session-id="${escapeHtml(row.session_id)}">
          <td><strong>${escapeHtml(rowMouseId(row))}</strong></td>
          <td>
            <strong>${escapeHtml(row.recording_date || "")}</strong>
            <div class="muted">${escapeHtml(row.task || "")}</div>
          </td>
          <td>
            <strong>${escapeHtml(row.probe_label || "")}</strong>
            <div class="muted">${escapeHtml(row.session_id)}</div>
          </td>
          <td>${badge(row.status)}</td>
          <td class="workflow-inline">${workflow || '<span class="muted">n/a</span>'}</td>
          <td class="muted">${escapeHtml(row.last_updated || "")}</td>
          <td>${links || '<span class="muted">none</span>'}</td>
        </tr>
      `;
    })
        .join("");
      return `${header}${probeRows}`;
    })
    .join("") || '<tr><td colspan="7" class="muted">No rows match the current filters.</td></tr>';
}

async function loadSelectedProbe() {
  if (!state.selectedSessionId) {
    state.selectedProbe = null;
    renderProbeDetail();
    return;
  }
  state.selectedProbe = await api(`/api/probes/${encodeURIComponent(state.selectedSessionId)}`);
  renderProbeDetail();
}

function renderProbeDetail() {
  const detail = state.selectedProbe;
  const selectedStatus = $("selected-status");
  if (!detail) {
    $("probe-summary").innerHTML = '<p class="muted">No probe selected.</p>';
    $("workflow-steps").innerHTML = "";
    $("probe-files").innerHTML = "";
    $("timing-list").innerHTML = "";
    $("extension-list").innerHTML = "";
    $("variant-list").innerHTML = "";
    $("probe-error").innerHTML = "";
    selectedStatus.textContent = "n/a";
    selectedStatus.className = "badge";
    return;
  }
  const row = detail.row || {};
  selectedStatus.textContent = row.status || "n/a";
  selectedStatus.className = `badge ${stageClass(row.status)}`;
  $("probe-summary").innerHTML = `
    <div><strong>${escapeHtml(row.probe_label || "")}</strong></div>
    <div>${escapeHtml(rowMouseId(row))} ${escapeHtml(row.recording_date || "")}</div>
    <div class="muted">${escapeHtml(row.session_id || "")}</div>
    <div>${badge(row.status)} raw backup ${badge(row.backup_status)} stage ${badge(row.local_stage_status || "missing")}</div>
    <div>synology output ${badge(row.derived_backup_status || "missing")} local output ${badge(row.derived_local_backup_status || "missing")}</div>
    <div>full recording D: archive ${badge(row.local_recording_archive_status || "missing")}</div>
    <div class="muted">${escapeHtml(row.last_updated || "")}</div>
  `;
  $("workflow-steps").innerHTML = (detail.workflow || [])
    .map(
      (step) => `
        <div class="workflow-step ${stageClass(step.status)}">
          <div class="step-top">
            <strong>${escapeHtml(step.label)}</strong>
            ${badge(step.status)}
          </div>
          <div class="muted">${escapeHtml(step.detail || "")}</div>
        </div>
      `
    )
    .join("");
  const outputs = detail.outputs || {};
  $("probe-files").innerHTML = [
    ["Folder", outputs.processed_folder],
    ["HTML", outputs.summary_html],
    ["PNG", outputs.summary_png],
    ["quality_metrics", outputs.quality_metrics_csv],
    ["channel_qc", outputs.channel_qc_csv],
    ["UnitRefine", outputs.unitrefine_labels],
    ["Phy params", outputs.phy_params],
    ["QC timings", outputs.qc_timings],
    ["NWB", outputs.nwb_nwb],
    ["NWB units", outputs.nwb_units_csv],
    ["NWB trials", outputs.nwb_trials_csv],
    ["Stimulus trials_df", outputs.nwb_stimulus_trials_csv],
    ["Frame sync residuals", outputs.nwb_frame_sync_residuals_csv],
    ["NWB TTL events", outputs.nwb_digital_events_csv],
    ["Stimulus manifest", outputs.nwb_stimulus_manifest],
    ["NWB manifest", outputs.nwb_manifest],
    ["NWB source log", outputs.nwb_source_resolution || outputs.nwb_source_resolution_json],
  ]
    .map(([label, path]) => `<div><span class="muted">${label}</span><br>${fileLink(path, path ? label : "") || '<span class="muted">missing</span>'}</div>`)
    .join("");
  $("timing-list").innerHTML = renderTimingList(detail.timings);
  $("extension-list").innerHTML = (detail.extension_status || [])
    .map((extension) => `<div class="extension ${stageClass(extension.status)}">${escapeHtml(extension.name)} ${badge(extension.status)}</div>`)
    .join("");
  $("variant-list").innerHTML = (detail.variants || [])
    .map((variant) => {
      const links = [
        fileLink(variant.summary_html, "HTML"),
        fileLink(variant.summary_png, "PNG"),
        fileLink(variant.qc_params, "params"),
        fileLink(variant.qc_timings, "timings"),
        fileLink(variant.unitrefine_labels, "labels"),
      ]
        .filter(Boolean)
        .join(" ");
      return `
        <div class="variant-item">
          <strong>${escapeHtml(variant.name)}</strong>
          <div class="muted">${escapeHtml(timingTotalText(variant.timings))}</div>
          <div>${links || '<span class="muted">no files</span>'}</div>
        </div>
      `;
    })
    .join("") || '<p class="muted">No QC variants yet.</p>';
  $("probe-error").innerHTML = row.error_message ? `<strong>Error</strong><pre>${escapeHtml(row.error_message)}</pre>` : "";
  renderNwbSessionSummary();
}

function renderNwbSessionSummary() {
  const group = selectedRecordingGroup();
  const row = representativeRow(group);
  const paths = row || {};
  const derived = derivedBackupSummary(group);
  const nwbBackup = nwbBackupSummary(group);
  if (!$("nwb-session-summary")) return;
  $("nwb-session-summary").innerHTML = row?.session_id
    ? `
      <div><strong>${escapeHtml(rowMouseId(row))} ${escapeHtml(row.recording_date || "")}</strong></div>
      <div>${escapeHtml(group?.name || recordingName(row))}</div>
      <div>${(group?.rows || [row]).map((item) => `${escapeHtml(item.probe_label || "probe")} ${badge(item.status)}`).join(" ")}</div>
      <div>NWB backup ${badge(nwbBackup.status)}</div>
      <div class="muted">${escapeHtml(nwbBackup.detail || "not checked yet")}</div>
      <div>Generated-output backup ${badge(derived.status)}</div>
      <div class="muted">${escapeHtml(derived.detail || "not checked yet")}</div>
      <div class="muted">Representative row: ${escapeHtml(row.session_id || "")}</div>
      <div class="muted">${escapeHtml(row.raw_folder || "")}</div>
    `
    : '<p class="muted">No recording selected.</p>';
  if (!state.stimulus) {
    setBadge("stimulus-status", "not loaded", "pending");
    setBadge("stimulus-input-status", "missing", "pending");
    setBadge("trials-input-status", "missing", "pending");
    $("stimulus-summary").innerHTML = '<p class="muted">Load digital events to preview stimulus/behavior processing.</p>';
    $("stimulus-event-counts").innerHTML = "";
    $("digital-event-name").innerHTML = "";
    $("stimulus-residuals").innerHTML = "";
    $("stimulus-preview").innerHTML = "";
    $("stimulus-files").innerHTML = "";
  }
  if (!state.units) {
    setBadge("units-status", "not loaded", "pending");
    setBadge("units-input-status", "missing", "pending");
    $("units-summary").innerHTML = '<p class="muted">Load units to preview the recording-level units dataframe.</p>';
    $("units-counts").innerHTML = "";
    $("units-preview").innerHTML = "";
    $("units-files").innerHTML = "";
  }
  setBadge("nwb-file-status", paths.nwb_status === "complete" ? "exists" : "missing", paths.nwb_status === "complete" ? "complete" : "pending");
  setBadge("nwb-backup-status", nwbBackup.status, stageClass(nwbBackup.status));
  setBadge("derived-backup-status", derived.status, stageClass(derived.status));
}

function renderStimulus(payload) {
  state.stimulus = payload;
  setBadge("stimulus-status", "loaded", "complete");
  setBadge("stimulus-input-status", "loaded", "complete");
  setBadge("trials-input-status", payload.trials_count ? "loaded" : "missing", payload.trials_count ? "complete" : "pending");
  const alignment = payload.alignment || {};
  const residual = payload.frame_sync_residual_ms || {};
  $("stimulus-summary").innerHTML = `
    <div><strong>${escapeHtml(payload.trials_count || 0)}</strong> trials_df rows</div>
    <div><strong>${escapeHtml(payload.digital_events_count || 0)}</strong> digital events</div>
    <div><strong>${escapeHtml(payload.session_events_count || 0)}</strong> behavior/session event rows</div>
    <div class="muted">Source: ${escapeHtml(payload.source || "rebuilt from raw/behavior files")}</div>
    ${renderWarnings(payload.warnings || [])}
    <div class="muted">Clock fit: ${escapeHtml(alignment.mode || "n/a")} Â· slope ${escapeHtml(formatNumber(alignment.slope, 9))}</div>
  `;
  const eventCounts = payload.event_counts || [];
  $("stimulus-event-counts").innerHTML =
    eventCounts
      .map((row) => {
        const eventName = row.event_name || "";
        return `
          <tr>
            <td><strong>${escapeHtml(eventName)}</strong></td>
            <td>${escapeHtml(row.line)}</td>
            <td>${escapeHtml(row.count)}</td>
            <td><button type="button" class="save-event-row" data-event-name="${escapeHtml(eventName)}">Use</button></td>
          </tr>
        `;
      })
      .join("") || '<tr><td colspan="4" class="muted">No digital events found.</td></tr>';
  $("digital-event-name").innerHTML = eventCounts
    .map((row) => `<option value="${escapeHtml(row.event_name)}">${escapeHtml(row.event_name)} (${escapeHtml(row.count)})</option>`)
    .join("");
  $("stimulus-residuals").innerHTML = `
    <div><strong>Frame sync residuals</strong></div>
    <div>mean ${escapeHtml(formatNumber(residual.mean, 3))} ms</div>
    <div>median ${escapeHtml(formatNumber(residual.median, 3))} ms</div>
    <div>median abs ${escapeHtml(formatNumber(residual.median_abs, 3))} ms</div>
    <div>95% range ${escapeHtml(formatNumber(residual.q05, 3))} to ${escapeHtml(formatNumber(residual.q95, 3))} ms</div>
  `;
  $("stimulus-preview").innerHTML = renderRecordsTable(payload.trials_preview || []);
  const paths = payload.paths || {};
  const savedNpys = payload.saved_npys || [];
  $("stimulus-files").innerHTML = [
    ["active_trials_override", paths.active_trials_csv],
    ["trials_df", paths.nwb_stimulus_trials_csv || paths.stimulus_trials_csv],
    ["frame_sync_residuals", paths.nwb_frame_sync_residuals_csv || paths.frame_sync_residuals_csv],
    ["stimulus_manifest", paths.nwb_stimulus_manifest || paths.stimulus_manifest],
    ["digital_events_csv", paths.nwb_digital_events_csv || paths.digital_events_csv],
    ["input_overrides", paths.input_overrides],
    ...savedNpys.map((item) => [`${item.name}.npy`, item.path]),
  ]
    .map(([label, path]) => `<div><span class="muted">${escapeHtml(label)}</span><br>${fileLink(path, path ? label : "") || '<span class="muted">missing</span>'}</div>`)
    .join("");
}

