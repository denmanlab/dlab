function updateComputedAgeFromDob() {
  const dobInput = $("nwb-subject-dob");
  const ageInput = $("nwb-subject-age");
  if (!dobInput || !ageInput) return;
  const dob = parseIsoDate(dobInput.value);
  const recordingDate = selectedRecordingDate();
  if (!dob || !recordingDate) {
    ageInput.value = "";
    return;
  }
  const days = Math.max(0, Math.floor((recordingDate - dob) / 86400000));
  ageInput.value = `P${days}D`;
}

function parseIsoDate(value) {
  const text = String(value || "").trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return null;
  const date = new Date(`${text}T00:00:00`);
  return Number.isNaN(date.getTime()) ? null : date;
}

function selectedRecordingDate() {
  const row = representativeRow(selectedRecordingGroup());
  const raw = row.raw_folder || "";
  const match = raw.match(/(\d{4}-\d{2}-\d{2})_(\d{2})-(\d{2})-(\d{2})/);
  if (match) {
    const date = new Date(`${match[1]}T${match[2]}:${match[3]}:${match[4]}`);
    if (!Number.isNaN(date.getTime())) return date;
  }
  return parseIsoDate(row.recording_date || "");
}

function formatBytes(bytes) {
  if (bytes === null || bytes === undefined || Number.isNaN(Number(bytes))) return "n/a";
  const units = ["B", "KB", "MB", "GB", "TB"];
  let value = Number(bytes);
  let index = 0;
  while (value >= 1024 && index < units.length - 1) {
    value /= 1024;
    index += 1;
  }
  return `${value.toFixed(index === 0 ? 0 : 1)} ${units[index]}`;
}

function renderSystem(payload) {
  const parts = [];
  const cpu = payload.cpu || {};
  parts.push(`CPU ${cpu.percent === null || cpu.percent === undefined ? "warming up" : `${cpu.percent}%`}`);
  const memory = payload.memory || {};
  if (memory.available) {
    parts.push(`RAM ${memory.percent}% (${formatBytes(memory.free_bytes)} free)`);
  } else {
    parts.push("RAM n/a");
  }
  (payload.disks || []).forEach((disk) => {
    parts.push(`${disk.label} disk ${formatBytes(disk.free_bytes)} free`);
  });
  const gpus = payload.gpus || [];
  if (gpus.length) {
    gpus.forEach((gpu) => {
      const used = gpu.memory_used_mib ?? "n/a";
      const total = gpu.memory_total_mib ?? "n/a";
      const util = gpu.utilization_percent ?? "n/a";
      const temp = gpu.temperature_c ?? "n/a";
      parts.push(`GPU${gpu.index ?? ""} ${util}% ${used}/${total} MiB ${temp}C`);
    });
  } else {
    parts.push("GPU n/a");
  }
  $("resource-card").innerHTML = parts.map((part) => `<span>${escapeHtml(part)}</span>`).join("");
}

