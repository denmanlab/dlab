  profile.preprocessing.highpass_filter ||= {};
  profile.preprocessing.highpass_filter.enabled = true;
  profile.preprocessing.highpass_filter.freq_min = Number($("profile-highpass").value);
  profile.preprocessing.car ||= {};
  profile.preprocessing.car.operator = $("profile-car").value;
  profile.preprocessing.bad_channels ||= {};
  profile.preprocessing.bad_channels.exclude_from_sorting = $("profile-exclude-bad").checked;
  profile.sorting ||= {};
  profile.sorting.params ||= {};
  profile.sorting.params.do_correction = $("profile-drift").checked;
  profile.sorting.params.nblocks = Number($("profile-nblocks").value);
  profile.jobs ||= {};
  profile.jobs.n_jobs = Number($("profile-n-jobs").value);
  profile.jobs.fallback_n_jobs = Number($("profile-fallback-jobs").value);
  profile.qc ||= {};
  profile.qc.sorting_analyzer ||= {};
  profile.qc.sorting_analyzer.num_spikes_for_sparsity = Number($("profile-sparsity-spikes").value);
  setExtensionEnabled(profile.qc, "principal_components", $("profile-pcs").checked);
  setExtensionEnabled(profile.qc, "spike_locations", $("profile-spike-locations").checked);
  profile.qc.automated_labels ||= {};
  profile.qc.automated_labels.enabled = $("profile-unitrefine").checked;
  profile.qc.export_phy = $("profile-phy").checked;
  return profile;
}

function setExtensionEnabled(qc, name, enabled) {
  qc.analyzer_extensions ||= [];
  let extension = qc.analyzer_extensions.find((item) => item.name === name);
  if (!extension) {
    extension = { name };
    qc.analyzer_extensions.push(extension);
  }
  extension.enabled = enabled;
}

function parseSimpleYamlProfile(text) {
  const selected = state.profiles.find((profile) => profile.name === state.selectedProfileName);
  if (selected && text.trim() === (selected.yaml || "").trim()) {
    return JSON.parse(JSON.stringify(selected.profile || {}));
  }
  // YAML validation and parsing is authoritative on the backend. Keep form edits
  // based on the last loaded object when the advanced text changed.
  return JSON.parse(JSON.stringify(state.profilePayload || {}));
}

async function saveCurrentProfile({ clone = false } = {}) {
  let name = $("profile-name").value.trim();
  if (clone) {
    name = prompt("New profile name", `${name}_copy`)?.trim() || "";
    if (!name) return;
  }
  const formOverrides = {
    "preprocessing.phase_shift.enabled": $("profile-phase-shift").checked,
    "preprocessing.highpass_filter.enabled": true,
    "preprocessing.highpass_filter.freq_min": Number($("profile-highpass").value),
    "preprocessing.car.operator": $("profile-car").value,
    "preprocessing.bad_channels.exclude_from_sorting": $("profile-exclude-bad").checked,
    "sorting.params.do_correction": $("profile-drift").checked,
    "sorting.params.nblocks": Number($("profile-nblocks").value),
    "jobs.n_jobs": Number($("profile-n-jobs").value),
    "jobs.fallback_n_jobs": Number($("profile-fallback-jobs").value),
    "qc.sorting_analyzer.num_spikes_for_sparsity": Number($("profile-sparsity-spikes").value),
    "qc.automated_labels.enabled": $("profile-unitrefine").checked,
    "qc.export_phy": $("profile-phy").checked,
    analyzer_extensions: {
      principal_components: $("profile-pcs").checked,
      spike_locations: $("profile-spike-locations").checked,
    },
  };
  const response = await api(`/api/profiles/${encodeURIComponent(name)}`, {
    method: "PUT",
    body: JSON.stringify({
      yaml: $("profile-editor").value,
      form_overrides: formOverrides,
      description: $("profile-description").value.trim(),
    }),
  });
  state.selectedProfileName = response.name;
  state.profileDirty = false;
  localStorage.setItem("selectedProfileName", state.selectedProfileName);
  $("profile-save-status").textContent = `Saved ${response.name} v${response.version}. Unstarted probes will use this version.`;
  await refresh();
}

function renderQueueActivity(payload) {
  const events = payload.events || [];
  const queueJobs = payload.jobs || [];
  const eventHtml = events
    .slice(-30)
    .reverse()
    .map(
      (event) => `
        <div class="job-item">
          <strong>${escapeHtml(event.event)}</strong> ${event.level === "error" ? badge("failed") : ""}
          <div>${escapeHtml(event.message)}</div>
          <div class="muted">${escapeHtml(event.session_id || event.queue_id || "")} ${escapeHtml(event.created_at || "")}</div>
        </div>
      `
    )
    .join("");
  const jobsHtml = queueJobs
    .slice(0, 15)
    .map(
      (job) => `
        <div class="job-item">
          <strong>${escapeHtml(job.kind)}</strong> ${badge(job.status)}
          <div>${escapeHtml(job.session_id || "")}</div>
          <div class="muted">${escapeHtml(job.profile_name || "")} v${escapeHtml(job.profile_version || "")}</div>
          <div>${fileLink(job.stdout_log, "stdout")} ${fileLink(job.stderr_log, "stderr")} ${fileLink(job.event_log, "events")}</div>
        </div>
      `
    )
    .join("");
  $("job-list").innerHTML = `${jobsHtml}${eventHtml}` || '<p class="muted">No persistent queue activity yet.</p>';
  if (payload.worker?.active_session_id) {
    $("active-job").textContent = `${payload.worker.active_session_id} running`;
    $("active-job").className = "badge running";
    $("progress-card").textContent = `Current queue step: ${payload.worker.active_session_id}`;
  }
}

async function refresh() {
  const [status, recordings, profiles, queueEvents, config, configText, reports, jobs, system] = await Promise.all([
    api("/api/status"),
    api("/api/recordings"),
    api("/api/profiles"),
    api("/api/queue/events?limit=100"),
    api("/api/config"),
    api("/api/config/text"),
    api("/api/reports"),
    api("/api/jobs"),
    api("/api/system"),
  ]);
  renderStatus(status);
  renderRecordingQueue(recordings);
  renderProfiles(profiles);
  await loadSelectedProbe();
  renderNwbMetadata(await api(`/api/nwb/metadata?session_id=${encodeURIComponent(selectedNwbSessionId() || "")}`));
  renderConfig(config, configText);
  renderReports(reports);
  renderSystem(system);
  await renderJobs(jobs);
  renderQueueActivity(queueEvents);
}

