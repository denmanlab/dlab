  state.units = payload;
  setBadge("units-status", "loaded", "complete");
  setBadge("units-input-status", payload.unit_count ? "loaded" : "missing", payload.unit_count ? "complete" : "pending");
  const columns = payload.columns || [];
  $("units-summary").innerHTML = `
    <div><strong>${escapeHtml(payload.unit_count || 0)}</strong> units across registered probes</div>
    <div><strong>${escapeHtml(columns.length)}</strong> scalar columns in the CSV/NWB units table</div>
    <div class="muted">Source: ${escapeHtml(payload.source || "rebuilt from pipeline outputs")}</div>
    ${renderWarnings(payload.warnings || [])}
    <div class="muted">Unique IDs use probe + sorter unit id, e.g. A_12 or B_12.</div>
  `;
  const probeCounts = payload.probe_counts || [];
  const labelCounts = payload.label_counts || [];
  $("units-counts").innerHTML = `
    <div><strong>By probe</strong></div>
    <div>${probeCounts.map((row) => `${escapeHtml(row.probe_label || "probe")}: ${escapeHtml(row.count)}`).join(" Â· ") || '<span class="muted">n/a</span>'}</div>
    <div><strong>UnitRefine labels</strong></div>
    <div>${labelCounts.map((row) => `${escapeHtml(row.unitrefine_label || "unlabeled")}: ${escapeHtml(row.count)}`).join(" Â· ") || '<span class="muted">n/a</span>'}</div>
  `;
  $("units-preview").innerHTML = renderRecordsTable(payload.preview || []);
  const paths = payload.paths || {};
  $("units-files").innerHTML = [
    ["active_units_override", paths.active_units_csv],
    ["nwb_units.csv", paths.nwb_units_csv || paths.units_csv],
    ["units manifest", paths.nwb_units_manifest || paths.units_manifest],
    ["input_overrides", paths.input_overrides],
  ]
    .map(([label, path]) => `<div><span class="muted">${escapeHtml(label)}</span><br>${fileLink(path, path ? label : "") || '<span class="muted">missing</span>'}</div>`)
    .join("");
}

function renderWarnings(warnings) {
  if (!warnings.length) return "";
  return `<div class="warning-list">${warnings.map((warning) => `<div>${escapeHtml(warning)}</div>`).join("")}</div>`;
}

function renderLoadedTrialsCsv(file, records) {
