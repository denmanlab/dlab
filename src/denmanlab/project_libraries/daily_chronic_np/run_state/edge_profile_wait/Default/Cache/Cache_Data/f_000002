function switchTab(tabId) {
  document.querySelectorAll(".tab").forEach((tab) => tab.classList.toggle("active", tab.dataset.tab === tabId));
  document.querySelectorAll(".tab-panel").forEach((panel) => panel.classList.toggle("active", panel.id === tabId));
}

function bindTabs() {
  document.querySelectorAll(".tab").forEach((tab) => {
    tab.addEventListener("click", () => switchTab(tab.dataset.tab));
  });
}

function bindControls() {
  const trialsInput = $("trials-csv-input");
  if (trialsInput) {
    trialsInput.addEventListener("change", () => loadCsvFileFromInput(trialsInput, "trials").catch((error) => alert(error.message)));
  }
  const unitsInput = $("units-csv-input");
  if (unitsInput) {
    unitsInput.addEventListener("change", () => loadCsvFileFromInput(unitsInput, "units").catch((error) => alert(error.message)));
  }

  document.addEventListener("input", (event) => {
    if (Object.prototype.hasOwnProperty.call(nwbMetadataFields, event.target.id)) {
      if (event.target.id === "nwb-subject-dob") updateComputedAgeFromDob();
      markNwbMetadataUnsaved();
    }
    if (
      ["profile-editor", "profile-name", "profile-description"].includes(event.target.id) ||
      event.target.closest?.(".profile-form")
    ) {
      state.profileDirty = true;
      $("profile-save-status").textContent = "Unsaved profile changes. Active probes remain on their frozen snapshots.";
    }
  });

  document.addEventListener("change", async (event) => {
    if (event.target.id === "queue-profile-select") {
      state.selectedProfileName = event.target.value || "default";
      localStorage.setItem("selectedProfileName", state.selectedProfileName);
    }
    if (event.target.id === "profile-select") {
      if (state.profileDirty && !confirm("Discard unsaved profile changes?")) {
        event.target.value = state.selectedProfileName;
        return;
      }
      state.selectedProfileName = event.target.value || "default";
      state.profileDirty = false;
      localStorage.setItem("selectedProfileName", state.selectedProfileName);
      renderProfiles({ profiles: state.profiles, default_profile: state.selectedProfileName });
    }
    if (event.target.id === "mouse-filter") {
      state.mouseFilter = event.target.value || "all";
      localStorage.setItem("mouseFilter", state.mouseFilter);
      await refresh();
    }
    if (event.target.id === "date-filter") {
      state.dateFilter = event.target.value || "all";
      localStorage.setItem("dateFilter", state.dateFilter);
      await refresh();
    }
    if (event.target.id === "session-select") {
      state.selectedSessionId = event.target.value;
      localStorage.setItem("selectedSessionId", state.selectedSessionId);
      const row = selectedRow();
      if (row.session_id) {
        state.selectedRecordingKey = recordingKey(row);
        localStorage.setItem("selectedRecordingKey", state.selectedRecordingKey);
      }
      state.stimulus = null;
      state.units = null;
      await loadSelectedProbe();
    }
    if (event.target.id === "nwb-recording-select") {
      state.selectedRecordingKey = event.target.value;
      localStorage.setItem("selectedRecordingKey", state.selectedRecordingKey);
      state.stimulus = null;
      state.units = null;
      renderNwbSessionSummary();
    }
  });

  document.addEventListener("click", async (event) => {
    const recording = event.target.closest("tr[data-recording-key]");
    if (recording) {
      state.selectedRecordingKey = recording.dataset.recordingKey;
      localStorage.setItem("selectedRecordingKey", state.selectedRecordingKey);
      state.stimulus = null;
      state.units = null;
      renderNwbSessionSummary();
      switchTab("nwb");
      return;
    }
    const row = event.target.closest("tr[data-session-id]");
    if (row) {
      state.selectedSessionId = row.dataset.sessionId;
      localStorage.setItem("selectedSessionId", state.selectedSessionId);
      $("session-select").value = state.selectedSessionId;
      const selected = selectedRow();
      if (selected.session_id) {
        state.selectedRecordingKey = recordingKey(selected);
        localStorage.setItem("selectedRecordingKey", state.selectedRecordingKey);
      }
      state.stimulus = null;
      state.units = null;
      await loadSelectedProbe();
      switchTab("workflow");
      return;
    }
    const button = event.target.closest("button");
    if (!button || button.classList.contains("tab")) return;
    try {
      if (button.id === "refresh") await refresh();
      if (button.classList.contains("enqueue-recording")) {
        const allowShort = button.dataset.short === "true";
        if (allowShort && !confirm("This is a short/survey block below the normal duration threshold. Queue it anyway?")) return;
        await api("/api/queue/enqueue", {
          method: "POST",
          body: JSON.stringify({
            recording_id: button.dataset.recordingId,
            profile_name: state.selectedProfileName,
            allow_short: allowShort,
          }),
        });
        await refresh();
        return;
      }
      if (button.dataset.openProbe) {
        state.selectedSessionId = button.dataset.openProbe;
        localStorage.setItem("selectedSessionId", state.selectedSessionId);
        $("session-select").value = state.selectedSessionId;
        await loadSelectedProbe();
        switchTab("workflow");
        return;
      }
      if (button.id === "queue-all") {
        if (!confirm(`Queue every eligible pending recording using profile "${state.selectedProfileName}"?`)) return;
        await api("/api/queue/enqueue-all", {
          method: "POST",
          body: JSON.stringify({ profile_name: state.selectedProfileName }),
        });
        await refresh();
        return;
      }
      if (button.id === "pause-queue") {
        await api("/api/queue/pause", { method: "POST", body: "{}" });
        await refresh();
        return;
      }
      if (button.id === "resume-queue") {
        await api("/api/queue/resume", { method: "POST", body: "{}" });
        await refresh();
        return;
      }
      if (button.id === "reconcile-interrupted") {
        const result = await api("/api/queue/reconcile-interrupted", { method: "POST", body: "{}" });
        alert(`Reconciled ${result.reconciled_session_ids.length} interrupted probe row(s).`);
        await refresh();
        return;
      }
      if (button.id === "save-profile") {
        await saveCurrentProfile();
        return;
      }
      if (button.id === "clone-profile") {
        await saveCurrentProfile({ clone: true });
        return;
      }
      if (button.classList.contains("save-event-row")) {
        const eventName = button.dataset.eventName || "";
        $("digital-event-name").value = eventName;
        const defaults = { game_frame: "gameframe", trial_start: "trial_starts", reward: "rewards" };
        $("digital-output-name").value = defaults[eventName] || eventName;
      }
      if (button.id === "load-stimulus") {
        await loadStimulus();
      }
      if (button.id === "load-default-stimulus") {
        await loadExistingStimulus();
      }
      if (button.id === "load-existing-stimulus") {
        $("trials-csv-input").click();
      }
      if (button.id === "clear-trials-override") {
        await clearNwbCsvOverride("trials");
      }
      if (button.id === "write-stimulus") {
        await writeStimulusFiles();
      }
      if (button.id === "load-units") {
        await loadUnits();
      }
      if (button.id === "load-default-units") {
        await loadExistingUnits();
      }
      if (button.id === "load-existing-units") {
        $("units-csv-input").click();
      }
      if (button.id === "clear-units-override") {
        await clearNwbCsvOverride("units");
      }
      if (button.id === "write-units") {
        await writeUnitsFile();
      }
      if (button.id === "save-nwb-metadata") {
        await saveNwbMetadata();
      }
      if (button.id === "export-nwb-recording") {
        const group = selectedRecordingGroup();
        const probeList = (group?.rows || []).map((row) => `${row.probe_label || "probe"}=${row.status || "n/a"}`).join(", ");
        const overwrite = $("overwrite-nwb").checked;
        if (
          !confirm(
            `Export NWB for this recording?\n\nRecording: ${group?.name || "n/a"}\nProbes: ${probeList}\nOverwrite existing NWB: ${overwrite ? "yes" : "no"}\n\nThis combines units across registered probes and writes trials, units, digital TTL streams, and metadata.`
          )
        ) {
          return;
        }
        await startJob("export-nwb", { session_id: selectedNwbSessionId(), overwrite });
      }
      if (button.id === "save-digital-event") {
        await saveSelectedDigitalEvent();
      }
      if (button.id === "show-out") {
        state.logStream = "out";
        await refresh();
      }
      if (button.id === "show-err") {
        state.logStream = "err";
        await refresh();
      }
      if (button.dataset.job) {
        const payload = {};
        await startJob(button.dataset.job, payload);
      }
      if (button.id === "run-one") {
        const row = selectedRow();
        const recording = state.recordings.find((item) => (item.probes || []).some((probe) => probe.session_id === row.session_id));
        if (!recording) throw new Error("Could not resolve the selected probe's recording.");
        if (!confirmProbeAction(`Queue the selected probe with profile "${state.selectedProfileName}"?`)) return;
        await api("/api/queue/enqueue", {
          method: "POST",
          body: JSON.stringify({
            recording_id: recording.recording_id,
            session_id: row.session_id,
            profile_name: state.selectedProfileName,
            allow_short: recording.short_recording,
          }),
        });
        await refresh();
        switchTab("overview");
        return;
      }
      if (button.id === "unitrefine") {
        if (!confirmProbeAction("Run UnitRefine on the selected probe?")) return;
        await startJob("unitrefine", { session_id: selectedSessionId(), label_set: "unitrefine_full" });
      }
      if (button.id === "export-phy") {
        if (
          !confirmProbeAction(
            "Export Phy for the selected probe?\n\nThis uses the existing SortingAnalyzer and latest UnitRefine labels. It will refuse to overwrite an existing phy folder."
          )
        ) {
          return;
        }
        await startJob("export-phy", { session_id: selectedSessionId(), overwrite_phy: false });
      }
      if (button.id === "export-nwb") {
        const overwrite = $("overwrite-nwb")?.checked || false;
        if (
          !confirmProbeAction(
            `Export the session-level mouse-arena NWB?\n\nThis combines ProbeA and ProbeB units with NI-DAQ TTLs and behavior events.\nOverwrite existing NWB: ${overwrite ? "yes" : "no"}`
          )
        ) {
          return;
        }
        await startJob("export-nwb", { session_id: selectedSessionId(), overwrite });
      }
      if (button.id === "resume-qc") {
        const row = selectedRow();
        const recording = state.recordings.find((item) => (item.probes || []).some((probe) => probe.session_id === row.session_id));
        if (!recording) throw new Error("Could not resolve the selected probe's recording.");
        if (!confirmProbeAction("Continue from the last valid artifact?")) return;
        await api("/api/queue/enqueue", {
          method: "POST",
          body: JSON.stringify({
            recording_id: recording.recording_id,
            session_id: row.session_id,
            profile_name: state.selectedProfileName,
            allow_short: recording.short_recording,
          }),
        });
        await refresh();
        switchTab("overview");
        return;
      }
      if (button.id === "restart-qc") {
        if (
          !confirmProbeAction(
            "Restart QC from the selected probe's existing Kilosort output?\n\nThis archives the current SortingAnalyzer, UnitRefine, Phy, reports, and metric CSVs before rebuilding QC. Kilosort output and raw data are kept."
          )
        ) {
          return;
        }
        await startJob("restart-qc", {
          session_id: selectedSessionId(),
          skip_phy: true,
        });
      }
      if (button.id === "run-qc-variant") {
        const payload = variantPayload();
        if (!payload.variant_name || !payload.variant_name.trim()) {
          alert("Variant name is required.");
          return;
        }
        if (!confirmProbeAction(`Run QC variant "${payload.variant_name}" from the existing Kilosort output?`)) return;
        await startJob("qc-variant", payload);
      }
      if (button.id === "save-config") {
        const result = await api("/api/config/text", {
          method: "PUT",
          body: JSON.stringify({ text: $("config-editor").value }),
        });
        $("config-save-status").textContent = `Saved ${result.path}`;
        await refresh();
      }
    } catch (error) {
      alert(error.message);
    }
  });
}

function init() {
  bindTabs();
  bindControls();
  refresh().catch((error) => {
    $("log-output").textContent = error.message;
  });
  setInterval(refresh, 5000);
}

document.addEventListener("DOMContentLoaded", init);


