function timingTotalText(timings) {
  if (!timings || !timings.exists || timings.total_elapsed_seconds === null || timings.total_elapsed_seconds === undefined) {
    return "timing unavailable";
  }
  return `phase total ${formatDuration(timings.total_elapsed_seconds)}`;
}

function formatDuration(seconds) {
  const value = Number(seconds || 0);
  if (value < 60) return `${value.toFixed(1)}s`;
  const minutes = Math.floor(value / 60);
  const remainder = Math.floor(value % 60);
  if (minutes < 60) return `${minutes}m${String(remainder).padStart(2, "0")}s`;
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return `${hours}h${String(mins).padStart(2, "0")}m${String(remainder).padStart(2, "0")}s`;
}

